{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

<section class="scentiva-collection-list-{{ section.id }}">
  <div class="page-width">

    <div class="scentiva-collection-heading">
      <span class="scentiva-collection-line"></span>

      <h2>{{ section.settings.title }}</h2>

      <span class="scentiva-collection-line"></span>
    </div>

    {%- liquid
      assign collection_list = collections

      case section.settings.sort
        when 'products_high'
          assign collection_list = collections | sort: 'all_products_count'
          assign collection_list = collection_list | reverse
        when 'products_low'
          assign collection_list = collections | sort: 'all_products_count'
        when 'date'
          assign collection_list = collections | sort: 'published_at'
        when 'date_reversed'
          assign collection_list = collections | sort: 'published_at'
          assign collection_list = collection_list | reverse
        when 'alphabetical_reversed'
          assign collection_list = collections | reverse
      endcase

      assign modulo_result = 28 | modulo: section.settings.columns_desktop
      assign paginate_by = 30

      if modulo_result == 0
        assign paginate_by = 28
      endif
    -%}

    {%- paginate collection_list by paginate_by -%}

      <ul
        class="scentiva-collection-grid grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
        role="list"
      >

        {%- for collection in collection_list -%}

          <li class="scentiva-collection-item grid__item">

            {% render 'card-collection',
              card_collection: collection,
              media_aspect_ratio: section.settings.image_ratio,
              columns: section.settings.columns_desktop
            %}

          </li>

        {%- endfor -%}

      </ul>

      {% render 'pagination', paginate: paginate %}

    {%- endpaginate -%}

  </div>
</section>

<style>

  /* ================================
     SCENTIVA COLLECTION LIST
     ================================ */

  #shopify-section-{{ section.id }} .scentiva-collection-heading {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 0 0 28px;
    padding: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .scentiva-collection-heading h2 {
    margin: 0 !important;
    padding: 0 !important;

    font-family: Georgia, 'Times New Roman', serif !important;
    font-size: 18px !important;
    line-height: 1.2 !important;
    font-weight: 400 !important;

    letter-spacing: .38em !important;
    text-transform: uppercase !important;
    text-align: center !important;

    color: #171411 !important;

    white-space: nowrap !important;
    word-break: normal !important;
    overflow: visible !important;

    flex: 0 0 auto !important;
  }

  #shopify-section-{{ section.id }} .scentiva-collection-line {
    display: block !important;

    width: 76px !important;
    min-width: 76px !important;
    height: 1px !important;

    margin: 0 !important;
    padding: 0 !important;

    background: #a88645 !important;

    flex: 0 0 76px !important;
  }


  /* ================================
     COLLECTION GRID
     ================================ */

  #shopify-section-{{ section.id }} .scentiva-collection-grid {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .scentiva-collection-item {
    min-width: 0;
  }


  /* ================================
     MOBILE
     ================================ */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .scentiva-collection-heading {
      width: 100%;
      gap: 8px;

      margin: 0 0 22px;
      padding: 0 8px;

      overflow: visible;
    }

    #shopify-section-{{ section.id }} .scentiva-collection-heading h2 {
      display: block !important;

      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;

      margin: 0 !important;
      padding: 0 !important;

      font-size: 14px !important;
      line-height: 1.2 !important;
      letter-spacing: .13em !important;

      white-space: nowrap !important;
      word-break: normal !important;

      flex: 0 1 auto !important;
      text-align: center !important;
    }

    #shopify-section-{{ section.id }} .scentiva-collection-line {
      width: 32px !important;
      min-width: 32px !important;

      flex: 0 1 32px !important;
    }

    #shopify-section-{{ section.id }} .scentiva-collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 8px !important;
      row-gap: 8px !important;
    }

  }

</style>

{% schema %}
{
  "name": "Scentiva Collection List",
  "tag": "section",
  "class": "scentiva-collection-list-wrapper",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "FRAGRANCE COLLECTIONS"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections",
      "options": [
        {
          "value": "alphabetical",
          "label": "Alphabetical"
        },
        {
          "value": "alphabetical_reversed",
          "label": "Alphabetical, reversed"
        },
        {
          "value": "date_reversed",
          "label": "Date, newest first"
        },
        {
          "value": "date",
          "label": "Date, oldest first"
        },
        {
          "value": "products_high",
          "label": "Products, high to low"
        },
        {
          "value": "products_low",
          "label": "Products, low to high"
        }
      ],
      "default": "alphabetical"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    }
  ]
}
{% endschema %}
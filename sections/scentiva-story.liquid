<section class="scentiva-story-section scentiva-story-{{ section.id }}">
  <div class="scentiva-story__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2200 }}" srcset="{{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ section.settings.image.alt | default: 'Scentiva story' | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'scentiva-placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="scentiva-story__overlay"></div>
  <div class="scentiva-story__content page-width">
    <div class="scentiva-story__copy">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="scentiva-story__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="scentiva-story__button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

<style>
  /* =========================================
     SCENTIVA — OUR STORY
     ========================================= */

  .scentiva-story-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 600px;
    overflow: hidden;
    background: #1b130d;
    color: #fff;
  }

  /* ---------- IMAGE ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__media,
  .scentiva-story-{{ section.id }} .scentiva-story__media img,
  .scentiva-story-{{ section.id }} .scentiva-placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__media img,
  .scentiva-story-{{ section.id }} .scentiva-placeholder-svg {
    object-fit: cover;
    object-position: center center;
  }

  /* ---------- DARK LEFT GRADIENT ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(20, 11, 6, 0.58) 0%,
        rgba(20, 11, 6, 0.42) 25%,
        rgba(20, 11, 6, 0.16) 48%,
        rgba(20, 11, 6, 0.03) 72%,
        rgba(20, 11, 6, 0.00) 100%
      );
  }

  /* ---------- CONTENT ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: none;

    min-height: 600px;

    display: flex;
    align-items: center;

    /* IMPORTANT:
       Do NOT use Shopify .page-width spacing here.
       This creates the correct left alignment. */
    padding-top: 60px;
    padding-bottom: 60px;
    padding-left: 10.5vw;
    padding-right: 5vw;

    margin: 0;
    box-sizing: border-box;
  }

  /* ---------- TEXT BLOCK ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__copy {
    width: 100%;
    max-width: 520px;
    margin: 0;
    text-align: left;
  }

  /* ---------- HEADING ---------- */

  .scentiva-story-{{ section.id }} h2 {
    margin: 0 0 24px;

    color: #d6ad68;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(42px, 4vw, 62px);

    font-weight: 400;

    line-height: 1.04;

    letter-spacing: 0.015em;

    text-transform: uppercase;

    text-align: left;
  }

  /* ---------- DESCRIPTION ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__text {
    max-width: 490px;

    margin: 0 0 32px;

    color: rgba(255, 250, 241, 0.92);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 16px;

    font-weight: 400;

    line-height: 1.65;

    letter-spacing: 0.015em;

    text-align: left;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__text p {
    margin: 0;
  }

  /* ---------- BUTTON ---------- */

  .scentiva-story-{{ section.id }} .scentiva-story__button {
    display: inline-flex;

    width: 235px;
    min-height: 58px;

    align-items: center;
    justify-content: center;

    box-sizing: border-box;

    border: 1px solid rgba(214, 173, 104, 0.95);

    background: rgba(25, 14, 7, 0.12);

    color: #d6ad68;

    text-decoration: none;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 12px;

    font-weight: 400;

    letter-spacing: 0.28em;

    text-transform: uppercase;

    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__button:hover {
    background: #d6ad68;
    border-color: #d6ad68;
    color: #1b130d;
  }


  /* =========================================
     LARGE DESKTOP
     ========================================= */

  @media (min-width: 1400px) {

    .scentiva-story-{{ section.id }} {
      min-height: 640px;
    }

    .scentiva-story-{{ section.id }} .scentiva-story__content {
      min-height: 640px;
      padding-left: 10.8vw;
    }

    .scentiva-story-{{ section.id }} .scentiva-story__copy {
      max-width: 510px;
    }

    .scentiva-story-{{ section.id }} h2 {
      font-size: 60px;
    }

  }


  /* =========================================
     TABLET
     ========================================= */

  @media (min-width: 750px) and (max-width: 1199px) {

    .scentiva-story-{{ section.id }} {
      min-height: 540px;
    }

    .scentiva-story-{{ section.id }} .scentiva-story__content {
      min-height: 540px;
      padding-left: 7vw;
      padding-right: 4vw;
    }

    .scentiva-story-{{ section.id }} .scentiva-story__copy {
      max-width: 430px;
    }

    .scentiva-story-{{ section.id }} h2 {
      font-size: 48px;
    }

  }


  /* =========================================
     MOBILE
     ========================================= */

  @media (max-width: 749px) {

  .scentiva-story-{{ section.id }} {
    min-height: 680px;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__media img {
    object-position: 35% center;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(20, 11, 6, 0.05) 0%,
        rgba(20, 11, 6, 0.10) 30%,
        rgba(20, 11, 6, 0.40) 52%,
        rgba(20, 11, 6, 0.80) 78%,
        rgba(20, 11, 6, 0.94) 100%
      );
  }

  /* MOVE THE ENTIRE TEXT BLOCK UP */
  .scentiva-story-{{ section.id }} .scentiva-story__content {
    min-height: 680px;

    display: flex;
    align-items: flex-start;

    padding-top: 260px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 0;

    box-sizing: border-box;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__copy {
    width: 100%;
    max-width: 350px;
    margin: 0;
    text-align: left;
  }

  .scentiva-story-{{ section.id }} h2 {
    margin: 0 0 20px;

    font-size: clamp(36px, 10vw, 48px);
    line-height: 1.02;
    letter-spacing: 0;

    color: #d6ad68;

    text-align: left;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__text {
    max-width: 340px;

    margin: 0 0 25px;

    color: rgba(255, 250, 241, 0.95);

    font-size: 14px;
    line-height: 1.6;

    text-align: left;
  }

  .scentiva-story-{{ section.id }} .scentiva-story__button {
    width: 190px;
    min-height: 50px;

    font-size: 10px;
    letter-spacing: 0.25em;
  }
}
</style>

{% schema %}
{
  "name": "Scentiva — Our story",
  "tag": "section",
  "class": "scentiva-story-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A SCENT\nFOR EVERY MOMENT" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Crafted for places, people and possibilities that shape your story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "OUR STORY" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Scentiva — Our story" }]
}
{% endschema %}
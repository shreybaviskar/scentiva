{%- liquid
  assign section_id = 'scentiva-luxury-collections-' | append: section.id
-%}

<section id="{{ section_id }}" class="scentiva-luxury-collections">
  <div class="scentiva-luxury-collections__intro">
    <div class="scentiva-luxury-collections__side scentiva-luxury-collections__side--left">
      {{ section.settings.left_label | newline_to_br }}
      <span class="scentiva-luxury-collections__side-rule"></span>
    </div>

    <div class="scentiva-luxury-collections__heading-wrap">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scentiva-luxury-collections__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="scentiva-luxury-collections__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="scentiva-luxury-collections__ornament" aria-hidden="true">
        <span></span><b>✦</b><span></span>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="scentiva-luxury-collections__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="scentiva-luxury-collections__side scentiva-luxury-collections__side--right">
      {{ section.settings.right_label | newline_to_br }}
    </div>
  </div>

  <div class="scentiva-luxury-collections__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign card_image = block.settings.image -%}
      {%- assign card_tone = block.settings.card_tone | default: 'light' -%}

      <article class="scentiva-luxury-card scentiva-luxury-card--{{ card_tone }}" {{ block.shopify_attributes }}>
        <a
          class="scentiva-luxury-card__media"
          href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
          aria-label="Explore {{ collection.title | default: block.settings.title | escape }}"
        >
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 1600 | image_tag:
              class: 'scentiva-luxury-card__image',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 25vw, 100vw',
              loading: 'lazy',
              alt: card_image.alt | default: collection.title | default: block.settings.title | escape
            }}
          {%- elsif collection != blank and collection.featured_image != blank -%}
            {{ collection.featured_image | image_url: width: 1600 | image_tag:
              class: 'scentiva-luxury-card__image',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 25vw, 100vw',
              loading: 'lazy',
              alt: collection.featured_image.alt | default: collection.title | escape
            }}
          {%- else -%}
            <div class="scentiva-luxury-card__placeholder">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
          <span class="scentiva-luxury-card__media-overlay" aria-hidden="true"></span>
        </a>

        <div class="scentiva-luxury-card__content">
          {%- assign display_title = collection.title | default: block.settings.title -%}
          {%- if display_title != blank -%}
            <h3 class="scentiva-luxury-card__title">{{ display_title }}</h3>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <p class="scentiva-luxury-card__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <div class="scentiva-luxury-card__description">{{ block.settings.description }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="scentiva-luxury-card__button" href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}">
              <span class="scentiva-luxury-card__button-label">{{ block.settings.button_label }}</span>
              <span class="scentiva-luxury-card__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if block.settings.bottom_text != blank -%}
            <p class="scentiva-luxury-card__bottom">{{ block.settings.bottom_text }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.settings.footer_quote != blank -%}
    <div class="scentiva-luxury-collections__footer">
      <span></span>
      <p>{{ section.settings.footer_quote }}</p>
      <span></span>
    </div>
  {%- endif -%}
</section>

<style>
  #{{ section_id }} {
    --slc-ink: #171411;
    --slc-muted: #7e6a4f;
    --slc-gold: #a88645;
    --slc-gold-soft: #c4a46b;
    --slc-cream: #f7f2e9;
    --slc-cream-deep: #eee1ce;
    --slc-warm: #2a1a11;
    --slc-stone: #e6d7c0;
    --slc-black: #10100f;
    --slc-light-text: #f6eee3;
    --slc-max-copy: 310px;
    background: var(--slc-cream);
    color: var(--slc-ink);
    overflow: hidden;
  }

  /* =========================
     EDITORIAL INTRO
     ========================= */
  #{{ section_id }} .scentiva-luxury-collections__intro {
    position: relative;
    min-height: 198px;
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(520px, 2fr) minmax(150px, 1fr);
    align-items: center;
    gap: 28px;
    padding: 34px 54px 28px;
    background:
      radial-gradient(circle at 50% 35%, rgba(255,255,255,.72), transparent 43%),
      linear-gradient(110deg, #eee5d8 0%, #faf6ef 48%, #eee2d1 100%);
  }

  #{{ section_id }} .scentiva-luxury-collections__heading-wrap {
    min-width: 0;
    text-align: center;
  }

  #{{ section_id }} .scentiva-luxury-collections__heading,
  #{{ section_id }} .scentiva-luxury-card__title,
  #{{ section_id }} .scentiva-luxury-card__description,
  #{{ section_id }} .scentiva-luxury-collections__side {
    font-family: var(--font-heading-family), Georgia, 'Times New Roman', serif;
  }

  #{{ section_id }} .scentiva-luxury-collections__eyebrow,
  #{{ section_id }} .scentiva-luxury-collections__subheading,
  #{{ section_id }} .scentiva-luxury-card__subtitle,
  #{{ section_id }} .scentiva-luxury-card__button,
  #{{ section_id }} .scentiva-luxury-card__bottom {
    font-family: var(--font-body-family), Arial, sans-serif;
  }

  #{{ section_id }} .scentiva-luxury-collections__eyebrow {
    margin: 0 0 10px;
    color: var(--slc-muted);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: .52em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__heading {
    margin: 0;
    color: var(--slc-ink) !important;
    font-size: clamp(43px, 4.2vw, 67px);
    font-weight: 400 !important;
    line-height: .98;
    letter-spacing: -.025em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 17px;
    margin: 14px auto 11px;
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament span {
    display: block;
    width: 118px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--slc-gold));
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament span:last-child {
    background: linear-gradient(90deg, var(--slc-gold), transparent);
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament b {
    color: var(--slc-gold);
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
  }

  #{{ section_id }} .scentiva-luxury-collections__subheading {
    margin: 0;
    color: var(--slc-muted);
    font-size: 9px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .46em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__side {
    color: #8b775d;
    font-size: 11px;
    font-style: italic;
    line-height: 1.75;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__side--right {
    justify-self: end;
    text-align: left;
  }

  #{{ section_id }} .scentiva-luxury-collections__side-rule {
    display: block;
    width: 68px;
    height: 1px;
    margin-top: 17px;
    background: #aa8b5d;
  }

  /* =========================
     FOUR-CARD GRID
     ========================= */
  #{{ section_id }} .scentiva-luxury-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  #{{ section_id }} .scentiva-luxury-card {
    position: relative;
    min-width: 0;
    min-height: 690px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-right: 2px solid var(--slc-cream);
    color: var(--slc-ink);
    transition: transform .45s cubic-bezier(.22,.61,.36,1), box-shadow .45s ease;
  }

  #{{ section_id }} .scentiva-luxury-card:last-child {
    border-right: 0;
  }

  #{{ section_id }} .scentiva-luxury-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / .91;
    overflow: hidden;
    background: #e7ded1;
    text-decoration: none !important;
  }

  #{{ section_id }} .scentiva-luxury-card__image,
  #{{ section_id }} .scentiva-luxury-card__placeholder,
  #{{ section_id }} .scentiva-luxury-card__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .scentiva-luxury-card__image {
    object-fit: cover;
    transition: transform .9s cubic-bezier(.2,.65,.2,1), filter .7s ease;
  }

  #{{ section_id }} .scentiva-luxury-card:hover .scentiva-luxury-card__image {
    transform: scale(1.025);
  }

  #{{ section_id }} .scentiva-luxury-card__media-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,.08));
    opacity: .22;
    transition: opacity .5s ease;
  }

  #{{ section_id }} .scentiva-luxury-card:hover .scentiva-luxury-card__media-overlay {
    opacity: .12;
  }

  #{{ section_id }} .scentiva-luxury-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 365px;
    padding: 30px 27px 24px;
    text-align: center;
  }

  #{{ section_id }} .scentiva-luxury-card__title {
    margin: 0 0 9px;
    color: inherit !important;
    font-size: clamp(27px, 2.15vw, 36px);
    font-weight: 400 !important;
    line-height: 1.05;
    letter-spacing: .018em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-card__subtitle {
    margin: 0 0 18px;
    color: inherit !important;
    font-size: 8px;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: .38em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-card__description {
    width: min(100%, var(--slc-max-copy));
    margin: 0 auto;
    color: inherit !important;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.58;
    letter-spacing: .005em;
  }

  /* =========================
     LUXURY BUTTON — EXPLICIT COLORS
     ========================= */
  #{{ section_id }} .scentiva-luxury-card__button {
    --button-border: currentColor;
    --button-bg: transparent;
    --button-text: currentColor;
    --button-hover-bg: var(--slc-ink);
    --button-hover-text: #fff;

    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    min-width: 205px;
    min-height: 43px;
    margin-top: 23px;
    padding: 11px 17px;
    overflow: hidden;
    border: 1px solid var(--button-border);
    background: var(--button-bg) !important;
    color: var(--button-text) !important;
    font-size: 8px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: .22em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition: color .32s ease, border-color .32s ease, transform .32s ease;
  }

  #{{ section_id }} .scentiva-luxury-card__button::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    background: var(--button-hover-bg);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform .38s cubic-bezier(.77,0,.18,1);
  }

  #{{ section_id }} .scentiva-luxury-card__button-label,
  #{{ section_id }} .scentiva-luxury-card__arrow {
    position: relative;
    z-index: 2;
    color: var(--button-text) !important;
    transition: color .32s ease, transform .32s ease;
  }

  #{{ section_id }} .scentiva-luxury-card__arrow {
    font-size: 15px;
    line-height: 0;
    letter-spacing: 0;
  }

  #{{ section_id }} .scentiva-luxury-card__button:hover,
  #{{ section_id }} .scentiva-luxury-card__button:focus-visible {
    background: transparent !important;
    border-color: var(--button-hover-bg) !important;
    color: var(--button-hover-text) !important;
    transform: translateY(-1px);
  }

  #{{ section_id }} .scentiva-luxury-card__button:hover::before,
  #{{ section_id }} .scentiva-luxury-card__button:focus-visible::before {
    transform: scaleX(1);
  }

  #{{ section_id }} .scentiva-luxury-card__button:hover .scentiva-luxury-card__button-label,
  #{{ section_id }} .scentiva-luxury-card__button:hover .scentiva-luxury-card__arrow,
  #{{ section_id }} .scentiva-luxury-card__button:focus-visible .scentiva-luxury-card__button-label,
  #{{ section_id }} .scentiva-luxury-card__button:focus-visible .scentiva-luxury-card__arrow {
    color: var(--button-hover-text) !important;
  }

  #{{ section_id }} .scentiva-luxury-card__button:hover .scentiva-luxury-card__arrow,
  #{{ section_id }} .scentiva-luxury-card__button:focus-visible .scentiva-luxury-card__arrow {
    transform: translateX(4px);
  }

  /* =========================
     CARD TONES
     ========================= */
  #{{ section_id }} .scentiva-luxury-card--light {
    background: var(--slc-cream-deep);
    color: var(--slc-ink);
    --button-border: rgba(23,20,17,.58);
    --button-text: var(--slc-ink);
    --button-hover-bg: var(--slc-ink);
    --button-hover-text: #f6eee3;
  }

  #{{ section_id }} .scentiva-luxury-card--warm {
    background: var(--slc-warm);
    color: var(--slc-light-text);
    --button-border: rgba(246,238,227,.78);
    --button-text: var(--slc-light-text);
    --button-hover-bg: #f2e5d4;
    --button-hover-text: #25170f;
  }

  #{{ section_id }} .scentiva-luxury-card--stone {
    background: var(--slc-stone);
    color: var(--slc-ink);
    --button-border: rgba(23,20,17,.58);
    --button-text: var(--slc-ink);
    --button-hover-bg: var(--slc-ink);
    --button-hover-text: #f6eee3;
  }

  #{{ section_id }} .scentiva-luxury-card--black {
    background: var(--slc-black);
    color: var(--slc-light-text);
    --button-border: rgba(246,238,227,.82);
    --button-text: var(--slc-light-text);
    --button-hover-bg: #f1dfc3;
    --button-hover-text: #15110d;
  }

  #{{ section_id }} .scentiva-luxury-card--black .scentiva-luxury-card__subtitle,
  #{{ section_id }} .scentiva-luxury-card--black .scentiva-luxury-card__bottom {
    color: var(--slc-gold-soft) !important;
  }

  #{{ section_id }} .scentiva-luxury-card--warm .scentiva-luxury-card__subtitle,
  #{{ section_id }} .scentiva-luxury-card--warm .scentiva-luxury-card__bottom {
    color: #d8c2a1 !important;
  }

  #{{ section_id }} .scentiva-luxury-card__bottom {
    margin: auto 0 0;
    padding-top: 27px;
    color: inherit !important;
    font-size: 7px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: .34em;
    text-transform: uppercase;
  }

  /* =========================
     FOOTER QUOTE
     ========================= */
  #{{ section_id }} .scentiva-luxury-collections__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 24px 18px 28px;
    background: #f8f3eb;
  }

  #{{ section_id }} .scentiva-luxury-collections__footer span {
    display: block;
    width: 64px;
    height: 1px;
    background: #bba27c;
  }

  #{{ section_id }} .scentiva-luxury-collections__footer p {
    margin: 0;
    color: #8a7352;
    font-family: var(--font-heading-family), Georgia, serif;
    font-size: 9px;
    font-style: italic;
    letter-spacing: .34em;
    text-transform: uppercase;
  }

  /* =========================
     RESPONSIVE
     ========================= */
  @media screen and (max-width: 989px) {
    #{{ section_id }} .scentiva-luxury-collections__intro {
      min-height: 170px;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 32px 24px 27px;
    }

    #{{ section_id }} .scentiva-luxury-collections__side {
      display: none;
    }

    #{{ section_id }} .scentiva-luxury-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .scentiva-luxury-card:nth-child(odd) {
      border-right: 2px solid var(--slc-cream);
    }

    #{{ section_id }} .scentiva-luxury-card:nth-child(-n+2) {
      border-bottom: 2px solid var(--slc-cream);
    }

    #{{ section_id }} .scentiva-luxury-card:nth-child(even) {
      border-right: 0;
    }

    #{{ section_id }} .scentiva-luxury-card__content {
      min-height: 350px;
      padding: 27px 22px 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .scentiva-luxury-collections__intro {
      min-height: 155px;
      padding: 29px 18px 24px;
    }

    #{{ section_id }} .scentiva-luxury-collections__heading {
      font-size: clamp(34px, 10vw, 48px);
      letter-spacing: -.02em;
    }

    #{{ section_id }} .scentiva-luxury-collections__eyebrow {
      font-size: 8px;
      letter-spacing: .38em;
    }

    #{{ section_id }} .scentiva-luxury-collections__ornament {
      gap: 10px;
      margin: 11px auto 9px;
    }

    #{{ section_id }} .scentiva-luxury-collections__ornament span {
      width: 70px;
    }

    #{{ section_id }} .scentiva-luxury-collections__subheading {
      font-size: 7px;
      letter-spacing: .3em;
    }

    #{{ section_id }} .scentiva-luxury-card__media {
      aspect-ratio: 1 / .86;
    }

    #{{ section_id }} .scentiva-luxury-card__content {
      min-height: 345px;
      padding: 24px 14px 22px;
    }

    #{{ section_id }} .scentiva-luxury-card__title {
      font-size: clamp(21px, 6vw, 28px);
    }

    #{{ section_id }} .scentiva-luxury-card__subtitle {
      font-size: 7px;
      letter-spacing: .25em;
      margin-bottom: 15px;
    }

    #{{ section_id }} .scentiva-luxury-card__description {
      font-size: 12px;
      line-height: 1.5;
    }

    #{{ section_id }} .scentiva-luxury-card__button {
      min-width: 0;
      width: 100%;
      max-width: 190px;
      padding-inline: 11px;
      font-size: 7px;
      letter-spacing: .16em;
    }

    #{{ section_id }} .scentiva-luxury-card__bottom {
      font-size: 6px;
      letter-spacing: .22em;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer {
      gap: 9px;
      padding: 20px 12px 23px;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer span {
      width: 30px;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer p {
      font-size: 7px;
      letter-spacing: .18em;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .scentiva-luxury-card__image,
    #{{ section_id }} .scentiva-luxury-card__button,
    #{{ section_id }} .scentiva-luxury-card__button::before,
    #{{ section_id }} .scentiva-luxury-card__button-label,
    #{{ section_id }} .scentiva-luxury-card__arrow {
      transition: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Luxury Collections",
  "tag": "section",
  "class": "scentiva-luxury-fragrance-collections",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRAGRANCES FOR EVERY YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "OUR COLLECTIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DIFFERENT EXPRESSIONS. A SHARED OBSESSION."
    },
    {
      "type": "textarea",
      "id": "left_label",
      "label": "Left editorial label",
      "default": "EXPLORE\nOUR WORLDS"
    },
    {
      "type": "textarea",
      "id": "right_label",
      "label": "Right editorial label",
      "default": "A SCENT\nFOR EVERY\nSTORY."
    },
    {
      "type": "text",
      "id": "footer_quote",
      "label": "Footer quote",
      "default": "NOT JUST FRAGRANCES, BUT WORLDS WITHIN."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Collection image", "info": "Use a custom image for the editorial card. If empty, the collection featured image is used." },
        { "type": "text", "id": "title", "label": "Fallback title", "info": "Used only when no collection is selected." },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },

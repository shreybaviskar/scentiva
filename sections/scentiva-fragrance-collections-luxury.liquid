            { "value": "light", "label": "Light" },
            { "value": "warm", "label": "Warm" },
            { "value": "stone", "label": "Stone" },
            { "value": "black", "label": "Black" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury fragrance collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "collection": "essentials",
            "subtitle": "EVERYDAY ELEGANCE",
            "description": "Versatile, affordable and effortlessly appealing. Designed for your daily moments.",
            "button_label": "EXPLORE ESSENTIALS",
            "bottom_text": "FRESH · MODERN · ACCESSIBLE",
            "card_tone": "light"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection": "signature",
            "subtitle": "DISTINCTLY YOU",
            "description": "A refined balance of style and character. Fragrances that leave a lasting impression.",
            "button_label": "EXPLORE SIGNATURE",
            "bottom_text": "VERSATILE · REFINED · MEMORABLE",
            "card_tone": "warm"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection": "maison",
            "subtitle": "INSPIRED BY ICONS",
            "description": "Timeless compositions crafted with the finest ingredients. A tribute to iconic perfumery.",
            "button_label": "EXPLORE MAISON",
            "bottom_text": "CLASSIC · LUXURIOUS · SOPHISTICATED",
            "card_tone": "stone"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection": "divine-series",
            "subtitle": "BEYOND THE ORDINARY",
            "description": "Rare. Exquisite. Unforgettable. Our most exclusive creations for true connoisseurs.",
            "button_label": "EXPLORE DIVINE SERIES",
            "bottom_text": "RARE · BOLD · EXTRAORDINARY",
            "card_tone": "black"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign section_id = 'scentiva-luxury-collections-' | append: section.id
-%}

<section id="{{ section_id }}" class="scentiva-luxury-collections">
  <div class="scentiva-luxury-collections__intro">
    <div class="scentiva-luxury-collections__side scentiva-luxury-collections__side--left">
      {{ section.settings.left_label | newline_to_br }}
      <span class="scentiva-luxury-collections__side-rule"></span>
    </div>

    <div class="scentiva-luxury-collections__heading-wrap">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scentiva-luxury-collections__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="scentiva-luxury-collections__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="scentiva-luxury-collections__ornament" aria-hidden="true">
        <span></span>
        <b>✦</b>
        <span></span>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="scentiva-luxury-collections__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="scentiva-luxury-collections__side scentiva-luxury-collections__side--right">
      {{ section.settings.right_label | newline_to_br }}
    </div>
  </div>

  <div class="scentiva-luxury-collections__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign card_image = block.settings.image -%}
      {%- assign card_tone = block.settings.card_tone -%}

      <article class="scentiva-luxury-card scentiva-luxury-card--{{ card_tone }}" {{ block.shopify_attributes }}>
        <a
          class="scentiva-luxury-card__media"
          href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
          aria-label="Explore {{ collection.title | default: block.settings.title | escape }}"
        >
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 1600 | image_tag:
              class: 'scentiva-luxury-card__image',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 25vw, 100vw',
              loading: 'lazy',
              alt: card_image.alt | default: collection.title | default: block.settings.title | escape
            }}
          {%- elsif collection != blank and collection.featured_image != blank -%}
            {{ collection.featured_image | image_url: width: 1600 | image_tag:
              class: 'scentiva-luxury-card__image',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 25vw, 100vw',
              loading: 'lazy',
              alt: collection.featured_image.alt | default: collection.title | escape
            }}
          {%- else -%}
            <div class="scentiva-luxury-card__placeholder">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
          <span class="scentiva-luxury-card__media-overlay"></span>
        </a>

        <div class="scentiva-luxury-card__content">
          {%- assign display_title = collection.title | default: block.settings.title -%}
          {%- if display_title != blank -%}
            <h3 class="scentiva-luxury-card__title">{{ display_title }}</h3>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <p class="scentiva-luxury-card__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <div class="scentiva-luxury-card__description">{{ block.settings.description }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="scentiva-luxury-card__button" href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}">
              <span>{{ block.settings.button_label }}</span>
              <span class="scentiva-luxury-card__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if block.settings.bottom_text != blank -%}
            <p class="scentiva-luxury-card__bottom">{{ block.settings.bottom_text }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.settings.footer_quote != blank -%}
    <div class="scentiva-luxury-collections__footer">
      <span></span>
      <p>{{ section.settings.footer_quote }}</p>
      <span></span>
    </div>
  {%- endif -%}
</section>

<style>
  #{{ section_id }} {
    --slc-ink: #171411;
    --slc-gold: #a88645;
    --slc-cream: #f6f0e7;
    --slc-soft: #eee3d3;
    --slc-dark: #17120e;
    background: var(--slc-cream);
    color: var(--slc-ink);
    overflow: hidden;
  }

  #{{ section_id }} .scentiva-luxury-collections__intro {
    position: relative;
    min-height: 198px;
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(520px, 2fr) minmax(150px, 1fr);
    align-items: center;
    gap: 28px;
    padding: 34px 54px 28px;
    background:
      radial-gradient(circle at 50% 35%, rgba(255,255,255,.48), transparent 42%),
      linear-gradient(110deg, #eee5d8 0%, #f8f3eb 48%, #eee2d1 100%);
  }

  #{{ section_id }} .scentiva-luxury-collections__heading-wrap {
    text-align: center;
    min-width: 0;
  }

  #{{ section_id }} .scentiva-luxury-collections__eyebrow,
  #{{ section_id }} .scentiva-luxury-collections__subheading,
  #{{ section_id }} .scentiva-luxury-collections__side,
  #{{ section_id }} .scentiva-luxury-card__subtitle,
  #{{ section_id }} .scentiva-luxury-card__bottom {
    font-family: var(--font-body-family), Arial, sans-serif;
  }

  #{{ section_id }} .scentiva-luxury-collections__eyebrow {
    margin: 0 0 10px;
    color: #806945;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: .46em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__heading {
    margin: 0;
    color: var(--slc-ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(42px, 4.2vw, 67px);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.025em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 15px auto 12px;
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament span {
    display: block;
    width: 118px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--slc-gold));
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament span:last-child {
    background: linear-gradient(to left, transparent, var(--slc-gold));
  }

  #{{ section_id }} .scentiva-luxury-collections__ornament b {
    color: var(--slc-gold);
    font-family: Georgia, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
  }

  #{{ section_id }} .scentiva-luxury-collections__subheading {
    margin: 0;
    color: #816d51;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: .42em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__side {
    color: #8b775d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 12px;
    font-style: italic;
    line-height: 1.75;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-collections__side--right {
    justify-self: end;
    text-align: left;
  }

  #{{ section_id }} .scentiva-luxury-collections__side-rule {
    display: block;
    width: 68px;
    height: 1px;
    margin-top: 18px;
    background: #aa8b5d;
  }

  #{{ section_id }} .scentiva-luxury-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  #{{ section_id }} .scentiva-luxury-card {
    position: relative;
    min-width: 0;
    min-height: 700px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-right: 2px solid var(--slc-cream);
    background: var(--slc-soft);
  }

  #{{ section_id }} .scentiva-luxury-card:last-child {
    border-right: 0;
  }

  #{{ section_id }} .scentiva-luxury-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / .96;
    overflow: hidden;
    background: #e7ded1;
    text-decoration: none;
  }

  #{{ section_id }} .scentiva-luxury-card__image,
  #{{ section_id }} .scentiva-luxury-card__placeholder,
  #{{ section_id }} .scentiva-luxury-card__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #{{ section_id }} .scentiva-luxury-card__image {
    object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.65,.2,1);
  }

  #{{ section_id }} .scentiva-luxury-card:hover .scentiva-luxury-card__image {
    transform: scale(1.035);
  }

  #{{ section_id }} .scentiva-luxury-card__placeholder svg {
    object-fit: cover;
  }

  #{{ section_id }} .scentiva-luxury-card__media-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,.08));
    opacity: .35;
  }

  #{{ section_id }} .scentiva-luxury-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 25px 26px 23px;
  }

  #{{ section_id }} .scentiva-luxury-card__title {
    margin: 0 0 9px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(27px, 2.15vw, 36px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: .025em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-card__subtitle {
    margin: 0 0 16px;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: .34em;
    text-transform: uppercase;
  }

  #{{ section_id }} .scentiva-luxury-card__description {
    max-width: 285px;
    min-height: 66px;
    margin: 0 auto;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 14px;
    line-height: 1.45;
  }

  #{{ section_id }} .scentiva-luxury-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-width: 205px;
    min-height: 41px;
    margin-top: 20px;
    padding: 10px 17px;
    border: 1px solid currentColor;
    color: inherit;
    font-family: var(--font-body-family), Arial, sans-serif;
    font-size: 9px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: .2em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .25s ease, color .25s ease;
  }

  #{{ section_id }} .scentiva-luxury-card__button:hover {
    background: currentColor;
    color: var(--slc-card-hover-text, #fff);
  }

  #{{ section_id }} .scentiva-luxury-card__arrow {
    font-size: 16px;
    line-height: 0;
    letter-spacing: 0;
  }

  #{{ section_id }} .scentiva-luxury-card__bottom {
    margin: auto 0 0;
    padding-top: 24px;
    font-size: 8px;
    line-height: 1.4;
    letter-spacing: .29em;
    text-transform: uppercase;
  }

  /* Light */
  #{{ section_id }} .scentiva-luxury-card--light {
    --slc-card-hover-text: #f6f0e7;
    background: #eee1ce;
    color: #171411;
  }

  #{{ section_id }} .scentiva-luxury-card--light .scentiva-luxury-card__media {
    background: #e7dac6;
  }

  /* Warm */
  #{{ section_id }} .scentiva-luxury-card--warm {
    --slc-card-hover-text: #f6f0e7;
    background: #2a1a11;
    color: #f5ecdf;
  }

  #{{ section_id }} .scentiva-luxury-card--warm .scentiva-luxury-card__media {
    background: #301a0c;
  }

  /* Stone */
  #{{ section_id }} .scentiva-luxury-card--stone {
    --slc-card-hover-text: #fff;
    background: #e6d7c0;
    color: #171411;
  }

  #{{ section_id }} .scentiva-luxury-card--stone .scentiva-luxury-card__media {
    background: #d8c9b2;
  }

  /* Black */
  #{{ section_id }} .scentiva-luxury-card--black {
    --slc-card-hover-text: #171411;
    background: #0d0d0c;
    color: #f4ead9;
  }

  #{{ section_id }} .scentiva-luxury-card--black .scentiva-luxury-card__media {
    background: #090909;
  }

  #{{ section_id }} .scentiva-luxury-card--black .scentiva-luxury-card__button:hover,
  #{{ section_id }} .scentiva-luxury-card--warm .scentiva-luxury-card__button:hover {
    color: #171411;
  }

  #{{ section_id }} .scentiva-luxury-card--black .scentiva-luxury-card__bottom,
  #{{ section_id }} .scentiva-luxury-card--warm .scentiva-luxury-card__bottom {
    color: #c9ad79;
  }

  #{{ section_id }} .scentiva-luxury-collections__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 66px;
    padding: 18px 24px;
    background: #f8f3eb;
  }

  #{{ section_id }} .scentiva-luxury-collections__footer span {
    width: 62px;
    height: 1px;
    background: #b69a70;
  }

  #{{ section_id }} .scentiva-luxury-collections__footer p {
    margin: 0;
    color: #806c52;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 11px;
    font-style: italic;
    letter-spacing: .3em;
    text-align: center;
    text-transform: uppercase;
  }

  @media screen and (max-width: 1199px) {
    #{{ section_id }} .scentiva-luxury-collections__intro {
      grid-template-columns: 120px minmax(0, 1fr) 120px;
      padding-left: 30px;
      padding-right: 30px;
    }

    #{{ section_id }} .scentiva-luxury-card {
      min-height: 650px;
    }

    #{{ section_id }} .scentiva-luxury-card__content {
      padding-left: 18px;
      padding-right: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .scentiva-luxury-collections__intro {
      min-height: 0;
      display: block;
      padding: 42px 22px 30px;
    }

    #{{ section_id }} .scentiva-luxury-collections__side {
      display: none;
    }

    #{{ section_id }} .scentiva-luxury-collections__eyebrow {
      margin-bottom: 9px;
      font-size: 9px;
      letter-spacing: .34em;
    }

    #{{ section_id }} .scentiva-luxury-collections__heading {
      font-size: clamp(34px, 10vw, 50px);
      line-height: 1;
    }

    #{{ section_id }} .scentiva-luxury-collections__ornament {
      gap: 11px;
      margin: 13px auto 10px;
    }

    #{{ section_id }} .scentiva-luxury-collections__ornament span {
      width: 58px;
    }

    #{{ section_id }} .scentiva-luxury-collections__subheading {
      font-size: 8px;
      letter-spacing: .25em;
    }

    #{{ section_id }} .scentiva-luxury-collections__grid {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .scentiva-luxury-card {
      min-height: 0;
      border-right: 0;
      border-bottom: 2px solid var(--slc-cream);
    }

    #{{ section_id }} .scentiva-luxury-card:last-child {
      border-bottom: 0;
    }

    #{{ section_id }} .scentiva-luxury-card__media {
      aspect-ratio: 1 / .92;
    }

    #{{ section_id }} .scentiva-luxury-card__content {
      padding: 27px 22px 26px;
    }

    #{{ section_id }} .scentiva-luxury-card__title {
      font-size: 30px;
    }

    #{{ section_id }} .scentiva-luxury-card__description {
      min-height: 0;
      max-width: 330px;
    }

    #{{ section_id }} .scentiva-luxury-card__bottom {
      padding-top: 23px;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer {
      gap: 10px;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer span {
      width: 32px;
    }

    #{{ section_id }} .scentiva-luxury-collections__footer p {
      font-size: 8px;
      letter-spacing: .2em;
    }
  }
</style>

{% schema %}
{
  "name": "Luxury fragrance collections",
  "tag": "section",
  "class": "scentiva-luxury-fragrance-collections",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRAGRANCES FOR EVERY YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "OUR COLLECTIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DIFFERENT EXPRESSIONS. A SHARED OBSESSION."
    },
    {
      "type": "textarea",
      "id": "left_label",
      "label": "Left editorial label",
      "default": "EXPLORE\nOUR WORLDS"
    },
    {
      "type": "textarea",
      "id": "right_label",
      "label": "Right editorial label",
      "default": "A SCENT\nFOR EVERY\nSTORY."
    },
    {
      "type": "text",
      "id": "footer_quote",
      "label": "Footer quote",
      "default": "NOT JUST FRAGRANCES, BUT WORLDS WITHIN."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection image",
          "info": "Use a custom image for the luxury editorial card. If empty, the collection's featured image is used."
        },
        {
          "type": "text",

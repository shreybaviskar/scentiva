<section class="scentiva-story-inspiration">
  <div class="scentiva-story-inspiration__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag:
        loading: 'lazy',
        widths: '800, 1200, 1600, 1800',
        sizes: '(min-width: 750px) 50vw, 100vw',
        alt: section.settings.image.alt | escape
      }}
    {% endif %}
  </div>
  <div class="scentiva-story-inspiration__copy">
    {% if section.settings.eyebrow != blank %}
      <p class="scentiva-story-inspiration__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="scentiva-story-inspiration__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="scentiva-story-inspiration__button">
        <span>{{ section.settings.button_label }}</span><span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

<style>
  .scentiva-story-inspiration {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    background: #f7f2e9;
    overflow: hidden;
  }

  .scentiva-story-inspiration__media {
    min-width: 0;
    min-height: 520px;
    overflow: hidden;
  }

  .scentiva-story-inspiration__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    object-position: center;
  }

  .scentiva-story-inspiration__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    padding: clamp(44px, 6vw, 88px) clamp(32px, 6.5vw, 100px);
  }

  .scentiva-story-inspiration__eyebrow {
    margin: 0 0 18px;
    color: #9b7745;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .28em;
    text-transform: uppercase;
  }

  .scentiva-story-inspiration h2 {
    max-width: 12ch;
    margin: 0 0 24px;
    color: #17130f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 4vw, 60px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .scentiva-story-inspiration__text {
    max-width: 46ch;
    color: #62584e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    line-height: 1.8;
  }

  .scentiva-story-inspiration__text p {
    margin: 0;
  }

  .scentiva-story-inspiration__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 54px;
    max-width: 100%;
    margin-top: 30px;
    padding: 0 24px;
    border: 1px solid #89704f;
    color: #241d17;
    background: transparent;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }

  .scentiva-story-inspiration__button:hover {
    border-color: #241d17;
    background: #241d17;
    color: #fff8ed;
  }

  .scentiva-story-inspiration__button span:last-child {
    flex: 0 0 auto;
    font-size: 16px;
    letter-spacing: 0;
  }

  @media screen and (max-width: 749px) {
    .scentiva-story-inspiration {
      grid-template-columns: minmax(0, 1fr);
    }

    .scentiva-story-inspiration__media {
      order: 1;
      min-height: 0;
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .scentiva-story-inspiration__media img {
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
      object-position: center;
    }

    .scentiva-story-inspiration__copy {
      order: 2;
      padding: 34px 24px 38px;
    }

    .scentiva-story-inspiration__eyebrow {
      margin-bottom: 12px;
      font-size: 9px;
      letter-spacing: .24em;
    }

    .scentiva-story-inspiration h2 {
      max-width: 15ch;
      margin-bottom: 18px;
      font-size: clamp(34px, 9vw, 44px);
      line-height: 1.08;
      letter-spacing: -.02em;
    }

    .scentiva-story-inspiration__text {
      max-width: 100%;
      font-size: 16px;
      line-height: 1.75;
    }

    .scentiva-story-inspiration__button {
      display: flex;
      width: 100%;
      min-height: 52px;
      margin-top: 24px;
      padding: 0 18px;
      letter-spacing: .12em;
    }
  }

  @media screen and (max-width: 360px) {
    .scentiva-story-inspiration__copy {
      padding-right: 20px;
      padding-left: 20px;
    }

    .scentiva-story-inspiration h2 {
      font-size: 33px;
    }

    .scentiva-story-inspiration__text {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Story Inspiration",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Inspiration"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "A World of Possibilities"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>From sunlit citrus groves to deep, resinous woods, every fragrance in our collection tells a story — a journey across time, place and emotion. We draw inspiration from nature, art, architecture and the people who make the world extraordinary.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Explore Our Collection"},
    {"type": "url", "id": "button_link", "label": "Button link"}
  ],
  "presets": [{"name": "Story Inspiration"}]
}
{% endschema %}

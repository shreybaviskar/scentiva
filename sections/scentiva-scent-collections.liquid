<section class="scentiva-collections-section scentiva-collections-{{ section.id }}">
  <div class="scentiva-collections__inner page-width">

    {%- if section.settings.heading != blank -%}
      <div class="scentiva-heading">
        <span></span>
        <h2>{{ section.settings.heading }}</h2>
        <span></span>
      </div>
    {%- endif -%}

    <div class="scentiva-collections__grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign image = block.settings.image | default: collection.image -%}

        <a
          class="scentiva-collection-card"
          href="{{ collection.url | default: routes.collections_url }}"
          {{ block.shopify_attributes }}
        >
          <div class="scentiva-collection-card__media">

            {%- if image != blank -%}
              <img
                src="{{ image | image_url: width: 900 }}"
                srcset="
                  {{ image | image_url: width: 450 }} 450w,
                  {{ image | image_url: width: 700 }} 700w,
                  {{ image | image_url: width: 900 }} 900w
                "
                sizes="(min-width: 990px) 20vw, 50vw"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'scentiva-placeholder-svg' }}
            {%- endif -%}

          </div>
        </a>

      {%- endfor -%}
    </div>

  </div>
</section>

<style>
.scentiva-collections-{{ section.id }}{
  background:#fbf8f1;
  padding:44px 0 54px;
  overflow:hidden;
}

.scentiva-collections-{{ section.id }} .scentiva-collections__inner{
  max-width:1400px;
}

.scentiva-collections-{{ section.id }} .scentiva-heading{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:18px;
  margin:0 0 28px;
  width:100%;
}

.scentiva-collections-{{ section.id }} .scentiva-heading span{
  display:block;
  width:76px;
  height:1px;
  background:#a88645;
  flex:0 0 76px;
}

.scentiva-collections-{{ section.id }} .scentiva-heading h2{
  margin:0;
  padding:0;
  font:400 18px/1.2 Georgia,'Times New Roman',serif;
  letter-spacing:.38em;
  text-transform:uppercase;
  color:#171411;
  white-space:nowrap;
  text-align:center;
}

.scentiva-collections-{{ section.id }} .scentiva-collections__grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:16px;
}

.scentiva-collections-{{ section.id }} .scentiva-collection-card{
  display:block;
  min-width:0;
  color:inherit;
  text-decoration:none;
}

.scentiva-collections-{{ section.id }} .scentiva-collection-card__media{
  position:relative;
  aspect-ratio:1/1;
  overflow:hidden;
  background:#2b241d;
}

.scentiva-collections-{{ section.id }} .scentiva-collection-card img,
.scentiva-collections-{{ section.id }} .scentiva-placeholder-svg{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  transition:transform .45s ease;
}

.scentiva-collections-{{ section.id }} .scentiva-collection-card:hover img{
  transform:scale(1.035);
}

@media(max-width:989px){
  .scentiva-collections-{{ section.id }} .scentiva-collections__grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}

@media(max-width:749px){

  .scentiva-collections-{{ section.id }}{
    padding:36px 0 42px;
  }

  .scentiva-collections-{{ section.id }} .scentiva-collections__inner{
    width:100%;
    max-width:none;
    padding-left:16px;
    padding-right:16px;
    box-sizing:border-box;
  }

  .scentiva-collections-{{ section.id }} .scentiva-heading{
    gap:8px;
    margin-bottom:22px;
    min-width:0;
  }

  .scentiva-collections-{{ section.id }} .scentiva-heading span{
    width:38px;
    flex:0 0 38px;
  }

  .scentiva-collections-{{ section.id }} .scentiva-heading h2{
    font-size:15px;
    letter-spacing:.18em;
    white-space:nowrap;
    flex:0 1 auto;
  }

  .scentiva-collections-{{ section.id }} .scentiva-collections__grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
    width:100%;
  }
}
</style>

{% schema %}
{
  "name": "Scent collections",
  "tag": "section",
  "class": "scentiva-scent-collections-wrapper",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "DISCOVER YOUR SCENT"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Scent collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. If empty, the collection image is used."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Display title",
          "info": "Not displayed. Collection name should be included in the image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "FRESH"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "WOODY"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "AMBER"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "FLORAL"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "GOURMAND"
          }
        }
      ]
    }
  ]
}
{% endschema %}
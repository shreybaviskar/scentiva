<section class="scentiva-story-hero">
  <div class="scentiva-story-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        widths: '900, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        class: 'scentiva-story-hero__image',
        alt: section.settings.image.alt | escape
      }}
    {% else %}
      <div class="scentiva-story-hero__placeholder"></div>
    {% endif %}
  </div>

  <div class="scentiva-story-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="scentiva-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="scentiva-story-hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
</section>

<style>
  .scentiva-story-hero{position:relative;min-height:68vh;display:grid;align-items:center;overflow:hidden;background:#21160f;color:#f8f1e6}
  .scentiva-story-hero__media{position:absolute;inset:0}
  .scentiva-story-hero__image{width:100%;height:100%;object-fit:cover;display:block}
  .scentiva-story-hero__media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,11,7,.90) 0%,rgba(18,11,7,.78) 34%,rgba(18,11,7,.38) 62%,rgba(18,11,7,.08) 100%),linear-gradient(0deg,rgba(18,11,7,.25),transparent 48%)}
  .scentiva-story-hero__placeholder{width:100%;height:100%;background:linear-gradient(120deg,#2b1a10,#9a7040 55%,#d9bd91)}
  .scentiva-story-hero__content{position:relative;z-index:1;width:min(1200px,calc(100% - 48px));margin:0 auto;padding:100px 0}\n  .scentiva-story-hero__content > *{max-width:650px}\n  .scentiva-story-hero__content h1,.scentiva-story-hero h1{color:#fff8ec!important;text-shadow:0 3px 26px rgba(0,0,0,.45)!important}\n  .scentiva-story-hero__content .scentiva-eyebrow{color:#e7c98e!important;text-shadow:0 2px 12px rgba(0,0,0,.5)}\n  .scentiva-story-hero__content .scentiva-story-hero__subheading{color:#fff4e3!important;text-shadow:0 2px 16px rgba(0,0,0,.65);max-width:560px}\n  .scentiva-story-hero__content{ text-shadow:0 2px 16px rgba(0,0,0,.25)}
  .scentiva-eyebrow{margin:0 0 20px;text-transform:uppercase;letter-spacing:.32em;font-size:11px;color:#d8b878}
  .scentiva-story-hero h1{max-width:650px;margin:0;font-family:Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(48px,6vw,92px);line-height:.98;letter-spacing:-.025em}
  .scentiva-story-hero__subheading{max-width:520px;margin:28px 0 0;font-family:Georgia,"Times New Roman",serif;font-size:18px;line-height:1.7;color:#eee3d3}
  @media(max-width:749px){
    .scentiva-story-hero{min-height:78vh;align-items:end}
    .scentiva-story-hero__content{width:calc(100% - 36px);padding:70px 0 52px}
    .scentiva-story-hero h1{font-size:clamp(44px,14vw,66px)}
    .scentiva-story-hero__media:after{background:linear-gradient(180deg,rgba(18,11,7,.10) 0%,rgba(18,11,7,.30) 28%,rgba(18,11,7,.88) 66%,rgba(18,11,7,.96) 100%)}\n    .scentiva-story-hero__content h1,.scentiva-story-hero h1{color:#fff8ec!important}\n    .scentiva-story-hero__content .scentiva-story-hero__subheading{color:#fff4e3!important}
  }
</style>

{% schema %}
{
  "name": "Story Hero",
  "settings": [
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Story"},
    {"type":"textarea","id":"heading","label":"Heading","default":"MORE THAN\nA SCENT.\nA STORY."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"The art of olfaction — fragrance created to capture moments, evoke emotion and become part of your story."}
  ],
  "presets":[{"name":"Story Hero"}]
}
{% endschema %}
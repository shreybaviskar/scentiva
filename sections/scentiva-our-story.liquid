    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-aspiration h2 {
      font-size: 45px;
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-values__grid,
    #ScentivaOurStory-{{ section.id }} .scentiva-story-worlds__grid {
      grid-template-columns: 1fr;
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-value {
      min-height: auto;
      padding: 32px 0;
      border-right: 0;
      border-bottom: 1px solid rgba(23,18,14,.16);
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-value:last-child {
      border-bottom: 0;
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-value__number {
      margin-bottom: 28px;
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-world {
      min-height: 500px;
    }

    #ScentivaOurStory-{{ section.id }} .scentiva-story-closing {
